// GoodTeams Platform Database Schema
// PostgreSQL + Prisma ORM
// Reference: docs/IMPLEMENTATION-PLAN-RBAC.md §4.1

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ORGANIZATION
// =============================================================================

model Organization {
  id               String    @id @default(uuid())
  name             String
  externalTenantId String?   @unique // Entra Tenant ID for SSO
  status           OrgStatus @default(PENDING)

  // Model configuration
  authorizedModels Json    @default("[]") // Array of authorized AI model IDs
  defaultModelId   String?

  // Relations
  users       User[]
  invitations OrganizationInvitation[]
  skills      OrganizationSkill[]
  auditLogs   AuditLog[]

  // Tenant management relations
  gateway     TenantGateway?
  config      TenantConfig?
  credentials TenantCredential[]

  // Connector relations (Phase 6)
  connections ResourceConnection[]

  // Workflow relations (Phase 7)
  workflows   Workflow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([externalTenantId])
  @@index([status])
}

// =============================================================================
// USER
// =============================================================================

model User {
  id       String   @id @default(uuid())
  email    String   @unique
  username String?
  role     UserRole @default(USER)

  // External identity (Entra Object ID)
  externalId String?

  // Organization membership
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  // Permissions (beyond role-based)
  permissions UserPermission[]

  // Invitations issued by this user
  issuedInvitations OrganizationInvitation[] @relation("InvitationIssuer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // OAuth tokens
  tokens UserToken[]

  @@index([organizationId])
  @@index([externalId])
  @@index([email])
}

// =============================================================================
// USER OAUTH TOKENS
// =============================================================================

model UserToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  provider      String   // "microsoft" | "google"
  accessToken   String   @db.Text  // Encrypted
  refreshToken  String?  @db.Text  // Encrypted
  expiresAt     DateTime
  scopes        String[] // Array of granted scopes
  
  // Provider-specific identifiers
  providerUserId  String?  // Microsoft OID or Google sub
  providerTenantId String? // Microsoft tenant ID
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, provider])
  @@index([userId])
  @@index([provider])
  @@index([expiresAt])
}

// =============================================================================
// ORGANIZATION INVITATION
// =============================================================================

model OrganizationInvitation {
  id        String           @id @default(uuid())
  email     String
  role      UserRole
  token     String           @unique
  status    InvitationStatus @default(PENDING)
  expiresAt DateTime

  // Entra metadata (pre-populated from directory search)
  externalId       String?
  entraUsername    String?
  entraDisplayName String?

  // Relations
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  issuerId       String
  issuer         User         @relation("InvitationIssuer", fields: [issuerId], references: [id])

  createdAt DateTime @default(now())

  @@unique([email, organizationId])
  @@index([token])
  @@index([status])
  @@index([expiresAt])
}

// =============================================================================
// USER PERMISSION
// =============================================================================

model UserPermission {
  id     String @id @default(uuid())
  name   String // Permission name (e.g., CRM_CREATE, SQL_EXECUTE)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  grantedAt DateTime @default(now())
  grantedBy String? // User ID who granted this permission

  @@unique([userId, name])
  @@index([userId])
}

// =============================================================================
// ORGANIZATION SKILL
// =============================================================================

model OrganizationSkill {
  id        String  @id @default(uuid())
  skillId   String // Unique skill identifier
  name      String
  version   String
  isEnabled Boolean @default(true)

  // Skill configuration (JSON blob)
  config       Json @default("{}")
  allowedRoles Json @default("[\"ADMIN\", \"USER\"]") // Which roles can use this skill

  // Organization relation
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  installedAt DateTime @default(now())
  installedBy String // User ID who installed the skill
  updatedAt   DateTime @updatedAt

  @@unique([organizationId, skillId])
  @@index([organizationId])
  @@index([skillId])
}

// =============================================================================
// AUDIT LOG
// =============================================================================

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Actor information
  actorId   String
  actorRole UserRole

  // Action details
  action     String // e.g., "user.role.changed", "invitation.created"
  targetType String // e.g., "user", "invitation", "skill"
  targetId   String?
  details    Json // Additional context

  // Request metadata
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserRole {
  SUPER_ADMIN // Platform-wide admin
  ADMIN // Organization admin
  USER // Regular user
  BILLING // Billing-only access
  VIEWER // Read-only access
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum OrgStatus {
  PENDING // Awaiting Entra connection
  ACTIVE // Fully operational
  SUSPENDED // Temporarily disabled
  ARCHIVED // Soft-deleted
}

enum GatewayStatus {
  PROVISIONING // Being set up
  STARTING // Process starting
  HEALTHY // Running and healthy
  UNHEALTHY // Running but failing health checks
  STOPPING // Gracefully stopping
  STOPPED // Gracefully stopped
  FAILED // Unexpected failure
}

// =============================================================================
// TENANT GATEWAY
// =============================================================================

model TenantGateway {
  id             String        @id @default(uuid())
  organizationId String        @unique
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  port   Int           @unique
  pid    Int?
  status GatewayStatus @default(PROVISIONING)

  lastHealthCheck     DateTime?
  consecutiveFailures Int       @default(0)

  memoryMb       Int?
  cpuPercent     Float?
  activeSessions Int    @default(0)

  configPath    String
  statePath     String
  workspacePath String

  startedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status])
  @@index([port])
}

// =============================================================================
// TENANT CONFIG
// =============================================================================

model TenantConfig {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  model        String  @default("anthropic/claude-sonnet-4-20250514")
  agentName    String  @default("Assistant")
  systemPrompt String?
  features     Json    @default("{}")

  maxTokensPerDay       Int @default(50000)
  maxConcurrentSessions Int @default(5)
  maxMemoryMb           Int @default(256)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =============================================================================
// TENANT CREDENTIAL
// =============================================================================

model TenantCredential {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  key            String
  encryptedValue String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  rotatedAt DateTime?

  @@unique([organizationId, key])
  @@index([organizationId])
}

// =============================================================================
// CONNECTOR ENUMS (Phase 6)
// =============================================================================

enum ConnectionType {
  SQL_SERVER
  POSTGRESQL
  MYSQL
  DATAVERSE
  SALESFORCE
}

enum ConnectionStatus {
  PENDING
  CONNECTED
  ERROR
  DISABLED
}

// =============================================================================
// RESOURCE CONNECTION (Phase 6)
// =============================================================================

model ResourceConnection {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  type        ConnectionType
  name        String
  description String?

  config      Json     // { url, database, schema, tdsPort, etc. }
  credentials String?  // Encrypted JSON

  status          ConnectionStatus @default(PENDING)
  lastHealthCheck DateTime?
  healthMessage   String?
  isReadOnly      Boolean          @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  schemaHints SchemaHint[]
  schemaCache SchemaCache?

  @@unique([organizationId, name])
  @@index([organizationId, type])
}

// =============================================================================
// SCHEMA HINT (Phase 6)
// =============================================================================

model SchemaHint {
  id           String             @id @default(uuid())
  connectionId String
  connection   ResourceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  tableName   String
  columnName  String?
  description String
  pattern     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  @@unique([connectionId, tableName, description])
  @@index([connectionId])
}

// =============================================================================
// SCHEMA CACHE (Phase 6)
// =============================================================================

model SchemaCache {
  id           String             @id @default(uuid())
  connectionId String             @unique
  connection   ResourceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  tables        Json
  relationships Json?

  cachedAt  DateTime @default(now())
  expiresAt DateTime
}

// =============================================================================
// WORKFLOW ENUMS (Phase 7)
// =============================================================================

enum WorkflowStatus {
  DRAFT     // Not yet activated
  ACTIVE    // Running and accepting triggers
  PAUSED    // Temporarily disabled
  ARCHIVED  // Soft-deleted
}

enum ExecutionStatus {
  PENDING           // Queued for execution
  RUNNING           // Currently executing
  COMPLETED         // Finished successfully
  FAILED            // Finished with error
  WAITING_FOR_INPUT // Paused waiting for user input
}

enum TriggerType {
  MANUAL   // Triggered via API or UI
  CRON     // Scheduled execution
  WEBHOOK  // HTTP webhook trigger
  CHAT     // Triggered from conversation
  EMAIL    // Triggered by incoming email
}

// =============================================================================
// WORKFLOW (Phase 7)
// =============================================================================

model Workflow {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name           String
  description    String?
  definition     Json           // { nodes: [], edges: [], globalConfig: {} }
  status         WorkflowStatus @default(DRAFT)

  triggerType    TriggerType?
  triggerConfig  Json?          // cron expression, webhook secret, etc.

  createdBy      String         // User ID who created the workflow
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  executions     WorkflowExecution[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([status])
  @@index([triggerType])
}

// =============================================================================
// WORKFLOW EXECUTION (Phase 7)
// =============================================================================

model WorkflowExecution {
  id          String          @id @default(uuid())
  workflowId  String
  workflow    Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  status      ExecutionStatus @default(PENDING)
  context     Json            // { inputs: {}, nodeOutputs: {}, globalVariables: {} }
  logs        Json            @default("[]") // [{ timestamp, nodeId, message, level }]

  triggeredBy String?         // userId or "cron" or "webhook"
  startedAt   DateTime        @default(now())
  finishedAt  DateTime?
  error       String?

  @@index([workflowId])
  @@index([status])
  @@index([startedAt])
}
